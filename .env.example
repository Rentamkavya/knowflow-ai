# KnowFlow AI Environment Variables
# Copy this file to .env and insert your real Gemini API key

# Gemini API Key (Required for vector embeddings & grounded Q&A generation)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Multi-tenant Workspace Identifier
WORKSPACE_ID=knowflow-enterprise-demo

# Optional Database Connection String (SQLite is used by default if omitted)
# DATABASE_URL=postgresql://user:password@localhost:5432/knowflow
